          propertyCollections:
            validators:
              10:
                identifier: StringLength
                editors:
                  200:
                    identifier: minimum
                    fieldExplanationText: 'Minimum length'
            finishers:
              10:
                identifier: EmailToReceiver
                editors:
                  300:
                    identifier: subject
                    fieldExplanationText: 'Subject of the mail'
