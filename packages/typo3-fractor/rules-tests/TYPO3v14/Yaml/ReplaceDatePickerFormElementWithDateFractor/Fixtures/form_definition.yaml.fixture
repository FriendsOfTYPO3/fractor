    label: Step
    renderables:
      -
        type: Date
        identifier: date-1
        label: 'Pick a date'
      -
        type: Date
        identifier: date-2
        label: Arrival
        properties:
          fluidAdditionalAttributes:
            required: required
        validators:
          -
            identifier: NotEmpty
        variants:
          -
            identifier: hide-on-summary
            condition: 'stepType == "SummaryPage"'
            renderingOptions:
              enabled: false
      -
        type: Text
        identifier: text-1
        label: Name
        properties:
          dateFormat: 'not a date picker'
